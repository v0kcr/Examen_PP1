<!-- views/website/register.ejs -->
<% layout("layouts/website") %>

<div class="container py-5">

  <div class="row justify-content-center g-4">

    <!-- ================================= -->
    <!-- INFORMACIÓN LATERAL -->
    <!-- ================================= -->
    <div class="col-lg-4 col-xl-3">

      <h1 class="h3 fw-bold">
        Crea tu cuenta<br>
        de estudiante
      </h1>

      <p class="text-secondary">
        Solo estudiantes con correo institucional de
        la Universidad de Lima pueden postular a
        las convocatorias.
      </p>

      <div class="alert alert-primary">

        <h6 class="fw-bold text-uppercase">
          Después del registro
        </h6>

        <ol class="mb-0 ps-3">
          <li class="mb-1">
            Verifica tu correo institucional.
          </li>

          <li class="mb-1">
            Completa tu perfil profesional.
          </li>

          <li>
            Postula a las convocatorias de tu carrera.
          </li>
        </ol>

      </div>

      <p class="small">
        ¿Representas a una empresa?
        <a href="/register/company" class="fw-bold">
          Registra tu empresa
        </a>
      </p>

    </div>


    <!-- ================================= -->
    <!-- FORMULARIO -->
    <!-- ================================= -->
    <div class="col-lg-8 col-xl-7">

      <div class="card">

        <div class="card-body p-4">

          <form action="/register" method="POST">

            <!-- Nombres / Apellidos -->
            <div class="row g-3">

              <div class="col-md-6">

                <label
                  for="txtNombres"
                  class="form-label">

                  Nombres

                </label>

                <input
                  type="text"
                  class="form-control"
                  id="txtNombres"
                  name="nombres"
                  placeholder="Mariana Lucía"
                  required
                >

              </div>


              <div class="col-md-6">

                <label
                  for="txtApellidos"
                  class="form-label">

                  Apellidos

                </label>

                <input
                  type="text"
                  class="form-control"
                  id="txtApellidos"
                  name="apellidos"
                  placeholder="Quispe Ramírez"
                  required
                >

              </div>

            </div>


            <!-- Correo -->
            <div class="mb-3 mt-3">

              <label
                for="txtEmail"
                class="form-label">

                Correo institucional

              </label>

              <input
                type="email"
                class="form-control"
                id="txtEmail"
                name="email"
                placeholder="mariana.quispe@aloe.ulima.edu.pe"
                required
              >

              <div class="form-text">
                Debe terminar en @aloe.ulima.edu.pe
              </div>

            </div>


            <!-- Contraseñas -->
            <div class="row g-3">

              <div class="col-md-6">

                <label
                  for="txtPassword"
                  class="form-label">

                  Contraseña

                </label>

                <div class="input-group">

                  <input
                    type="password"
                    class="form-control"
                    id="txtPassword"
                    name="password"
                    placeholder="••••••••"
                    required
                  >

                  <button
                    type="button"
                    class="btn btn-outline-secondary"
                    onclick="togglePassword('txtPassword', this)">

                    Mostrar

                  </button>

                </div>

                <div class="mt-2">

                  <div class="progress" style="height: 4px;">

                    <div
                      class="progress-bar bg-success"
                      role="progressbar"
                      style="width: 70%">
                    </div>

                  </div>

                  <small class="text-success">
                    Fortaleza: segura
                  </small>

                </div>

              </div>


              <div class="col-md-6">

                <label
                  for="txtConfirmPassword"
                  class="form-label">

                  Confirmar contraseña

                </label>

                <input
                  type="password"
                  class="form-control"
                  id="txtConfirmPassword"
                  name="confirmPassword"
                  placeholder="••••••••"
                  required
                >

                <div class="form-text">
                  Mínimo 8 caracteres, con una mayúscula y un número.
                </div>

              </div>

            </div>


            <!-- Carrera / Ciclo -->
            <div class="row g-3 mt-1">

              <div class="col-md-8">

                <label
                  for="selectCarrera"
                  class="form-label">

                  Carrera

                </label>

                <select
                  class="form-select"
                  id="selectCarrera"
                  name="carrera"
                  required>

                  <option value="" selected disabled>
                    Selecciona tu carrera
                  </option>

                  <option value="ingenieria-sistemas">
                    Ingeniería de Sistemas
                  </option>

                  <option value="administracion">
                    Administración
                  </option>

                  <option value="contabilidad">
                    Contabilidad
                  </option>

                  <option value="economia">
                    Economía
                  </option>

                  <option value="derecho">
                    Derecho
                  </option>

                  <option value="comunicacion">
                    Comunicación
                  </option>

                </select>

              </div>


              <div class="col-md-4">

                <label
                  for="selectCiclo"
                  class="form-label">

                  Ciclo

                </label>

                <select
                  class="form-select"
                  id="selectCiclo"
                  name="ciclo"
                  required>

                  <option value="" selected disabled>
                    Selecciona
                  </option>

                  <option value="1">Primero</option>
                  <option value="2">Segundo</option>
                  <option value="3">Tercero</option>
                  <option value="4">Cuarto</option>
                  <option value="5">Quinto</option>
                  <option value="6">Sexto</option>
                  <option value="7">Séptimo</option>
                  <option value="8">Octavo</option>
                  <option value="9">Noveno</option>
                  <option value="10">Décimo</option>

                </select>

              </div>

            </div>


            <!-- Términos -->
            <div class="form-check mt-4">

              <input
                class="form-check-input"
                type="checkbox"
                id="chkTerms"
                name="terms"
                required
              >

              <label
                class="form-check-label"
                for="chkTerms">

                Acepto los
                <a href="/terminos">
                  términos del servicio
                </a>
                y la
                <a href="/privacidad">
                  política de privacidad de datos
                </a>
                de la plataforma.

              </label>

            </div>


            <!-- Botón -->
            <button
              type="submit"
              class="btn btn-primary w-100 mt-3">

              Crear mi cuenta

            </button>


            <!-- Login -->
            <div class="text-center mt-3">

              <span class="text-secondary small">
                ¿Ya tienes una cuenta?
              </span>

              <a
                href="/login"
                class="fw-bold small">

                Inicia sesión

              </a>

            </div>

          </form>

        </div>

      </div>

    </div>

  </div>

</div>


<script>

  function togglePassword(inputId, button) {

    const input = document.getElementById(inputId);

    if (input.type === "password") {

      input.type = "text";
      button.textContent = "Ocultar";

    } else {

      input.type = "password";
      button.textContent = "Mostrar";

    }

  }

</script>
