<!-- views/website/contact.ejs -->
<% layout("layouts/website") %>
<section class="bg-gray-100">

  <div class="mx-auto max-w-6xl">

    <!-- Encabezado -->
    <div class="mb-10">
      <h1 class="text-4xl font-bold text-primary">
        Contáctanos
      </h1>

      <p class="mt-3 text-gray-600">
        Si tienes alguna consulta, sugerencia o necesitas más información,
        puedes comunicarte con nosotros.
      </p>
    </div>


    <div class="grid gap-8 md:grid-cols-3">

      <!-- Información -->
      <div class="rounded-xl bg-white p-6 shadow md:col-span-1">

        <h2 class="mb-6 text-xl font-bold text-primary">
          Información
        </h2>


        <div class="space-y-5">

          <div class="flex items-center gap-4">
            <i class="fa-solid fa-location-dot text-2xl text-primary"></i>

            <div>
              <p class="font-semibold">
                Ubicación
              </p>
              <p class="text-sm text-gray-500">
                Universidad de Lima
              </p>
            </div>
          </div>


          <div class="flex items-center gap-4">

            <i class="fa-solid fa-envelope text-2xl text-primary"></i>

            <div>
              <p class="font-semibold">
                Email
              </p>

              <p class="text-sm text-gray-500">
                contacto@ulimafifa.com
              </p>
            </div>

          </div>


          <div class="flex items-center gap-4">

            <i class="fa-solid fa-phone text-2xl text-primary"></i>

            <div>
              <p class="font-semibold">
                Teléfono
              </p>

              <p class="text-sm text-gray-500">
                +51 999 999 999
              </p>
            </div>

          </div>


        </div>

      </div>



      <!-- Formulario -->
      <div class="rounded-xl bg-white p-6 shadow md:col-span-2">

        <h2 class="mb-6 text-xl font-bold text-primary">
          Envíanos un mensaje
        </h2>


        <form action="/contact" method="POST" class="space-y-5">


          <div class="grid gap-5 md:grid-cols-2">

            <div>
              <label class="mb-2 block text-sm font-medium">
                Nombre
              </label>

              <input
                type="text"
                name="name"
                class="w-full rounded-lg border border-gray-300 px-4 py-2 outline-none focus:border-primary"
                placeholder="Tu nombre"
              >
            </div>


            <div>
              <label class="mb-2 block text-sm font-medium">
                Email
              </label>

              <input
                type="email"
                name="email"
                class="w-full rounded-lg border border-gray-300 px-4 py-2 outline-none focus:border-primary"
                placeholder="correo@email.com"
              >
            </div>

          </div>



          <div>

            <label class="mb-2 block text-sm font-medium">
              Asunto
            </label>

            <input
              type="text"
              name="subject"
              class="w-full rounded-lg border border-gray-300 px-4 py-2 outline-none focus:border-primary"
              placeholder="Motivo del mensaje"
            >

          </div>



          <div>

            <label class="mb-2 block text-sm font-medium">
              Mensaje
            </label>

            <textarea
              name="message"
              rows="5"
              class="w-full rounded-lg border border-gray-300 px-4 py-2 outline-none focus:border-primary"
              placeholder="Escribe tu mensaje..."
            ></textarea>

          </div>



          <button
            type="submit"
            class="rounded-lg bg-primary px-6 py-3 font-semibold text-white transition hover:opacity-90"
          >
            Enviar mensaje
          </button>


        </form>

      </div>

    </div>

  </div>

</section>