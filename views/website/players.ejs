<!-- views/website/players.ejs -->
<% layout("layouts/website") %>
<main class="w-full bg-gray-100 p-8 md:w-4/5">

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-bold text-primary">
      Jugadores
    </h1>
    <p class="text-gray-600 mt-2">
      Consulta la información y estadísticas de los jugadores registrados.
    </p>
  </div>


  <!-- Buscador -->
  <section class="mb-8 rounded-xl bg-white p-6 shadow">

    <div class="grid grid-cols-1 gap-4 md:grid-cols-4">

      <!-- Nombre -->
      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">
          Buscar jugador
        </label>

        <input
          type="text"
          placeholder="Ej: Lionel Messi"
          class="w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-primary focus:outline-none"
        >
      </div>


      <!-- Posición -->
      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">
          Posición
        </label>

        <select class="w-full rounded-lg border border-gray-300 px-4 py-2">
          <option>Todos</option>
          <option>Delantero</option>
          <option>Medio</option>
          <option>Defensa</option>
          <option>Arquero</option>
        </select>
      </div>


      <!-- Pie -->
      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">
          Pie
        </label>

        <select class="w-full rounded-lg border border-gray-300 px-4 py-2">
          <option>Todos</option>
          <option>Derecho</option>
          <option>Izquierdo</option>
        </select>
      </div>


      <!-- Botón -->
      <div class="flex items-end">
        <button
          class="w-full rounded-lg bg-primary px-5 py-2 text-white hover:opacity-90"
        >
          <i class="fa-solid fa-magnifying-glass mr-2"></i>
          Buscar
        </button>
      </div>

    </div>

  </section>



  <!-- Cards -->
  <section class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">


    <!-- Player Card -->
    <article class="overflow-hidden rounded-xl bg-white shadow">


      <!-- Imagen -->
      <div class="relative bg-gradient-to-r from-primary to-secondary p-6 text-center">

        <img
          src="https://cdn.sofifa.net/players/158/023/25_120.png"
          class="mx-auto h-32 w-32 rounded-full border-4 border-white object-cover"
        >

        <span
          class="absolute right-4 top-4 rounded-lg bg-white px-3 py-1 text-xl font-bold text-primary"
        >
          91
        </span>

      </div>


      <!-- Información -->
      <div class="p-6">


        <h2 class="text-2xl font-bold text-gray-800">
          Lionel Messi
        </h2>

        <p class="text-sm text-gray-500">
          Argentina 🇦🇷
        </p>


        <div class="mt-4 grid grid-cols-2 gap-3 text-sm">


          <div>
            <span class="text-gray-500">
              Posición
            </span>

            <p class="font-semibold">
              Extremo Derecho
            </p>
          </div>


          <div>
            <span class="text-gray-500">
              Pie
            </span>

            <p class="font-semibold">
              Izquierdo
            </p>
          </div>


          <div>
            <span class="text-gray-500">
              Edad
            </span>

            <p class="font-semibold">
              38 años
            </p>
          </div>


          <div>
            <span class="text-gray-500">
              Altura
            </span>

            <p class="font-semibold">
              170 cm
            </p>
          </div>


        </div>


        <!-- Stats -->
        <div class="mt-6 flex justify-between border-t pt-4 text-center">


          <div>
            <p class="text-xl font-bold text-primary">
              5★
            </p>
            <span class="text-xs text-gray-500">
              Skills
            </span>
          </div>


          <div>
            <p class="text-xl font-bold text-primary">
              4★
            </p>
            <span class="text-xs text-gray-500">
              Weak Foot
            </span>
          </div>


          <div>
            <p class="text-xl font-bold text-primary">
              89
            </p>
            <span class="text-xs text-gray-500">
              Rank
            </span>
          </div>


        </div>


      </div>


    </article>





    <!-- Segunda card ejemplo -->
    <article class="overflow-hidden rounded-xl bg-white shadow">

      <div class="bg-gradient-to-r from-primary to-secondary p-6 text-center">

        <img
          src="https://cdn.sofifa.net/players/231/747/25_120.png"
          class="mx-auto h-32 w-32 rounded-full border-4 border-white"
        >

      </div>


      <div class="p-6">

        <h2 class="text-2xl font-bold">
          Kylian Mbappé
        </h2>

        <p class="text-sm text-gray-500">
          Francia 🇫🇷
        </p>


        <div class="mt-4 grid grid-cols-2 gap-3">

          <p>
            <span class="text-gray-500">
              Posición
            </span>
            <br>
            <b>Delantero</b>
          </p>


          <p>
            <span class="text-gray-500">
              Pie
            </span>
            <br>
            <b>Derecho</b>
          </p>


        </div>


      </div>

    </article>


  </section>


</main>