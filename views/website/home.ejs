<!-- views/website/home.ejs -->

<% layout("layouts/website") %>


<!-- =========================================================
     HERO
========================================================= -->

<section class="bg-dark text-white">

  <div
    id="heroCarousel"
    class="carousel slide carousel-fade"
    data-bs-ride="carousel"
    data-bs-interval="6000">

    <!-- Indicadores -->
    <div class="carousel-indicators">

      <button
        type="button"
        data-bs-target="#heroCarousel"
        data-bs-slide-to="0"
        class="active"
        aria-current="true"
        aria-label="Slide 1">
      </button>

      <button
        type="button"
        data-bs-target="#heroCarousel"
        data-bs-slide-to="1"
        aria-label="Slide 2">
      </button>

      <button
        type="button"
        data-bs-target="#heroCarousel"
        data-bs-slide-to="2"
        aria-label="Slide 3">
      </button>

    </div>


    <div class="carousel-inner">


      <!-- =====================================================
           SLIDE 1
      ====================================================== -->

      <div class="carousel-item active">

        <div
          class="container-fluid"
          style="
            min-height: 620px;
            background:
              linear-gradient(
                90deg,
                rgba(0,0,0,.90),
                rgba(0,0,0,.60),
                rgba(0,0,0,.25)
              ),
              url('/assets/img/slider-1.jpg')
              center/cover;
          ">

          <div
            class="container d-flex align-items-center"
            style="min-height: 620px;">

            <div class="row w-100">

              <div class="col-lg-7">

                <span class="badge bg-success mb-3 px-3 py-2">
                  OPORTUNIDADES PARA ESTUDIANTES
                </span>

                <h1 class="display-3 fw-bold mb-4">
                  Encuentra tu próxima
                  <span class="text-success">
                    oportunidad profesional
                  </span>
                </h1>

                <p class="lead text-light mb-4">
                  Descubre ofertas de prácticas pre-profesionales
                  y conecta con empresas que buscan talento
                  universitario.
                </p>

                <div class="d-flex flex-wrap gap-2">

                  <a
                    href="/convocatorias"
                    class="btn btn-success btn-lg px-4">

                    <i class="fa-solid fa-briefcase me-2"></i>
                    Ver ofertas

                  </a>

                  <a
                    href="/register"
                    class="btn btn-outline-light btn-lg px-4">

                    <i class="fa-solid fa-user-plus me-2"></i>
                    Crear cuenta

                  </a>

                </div>

              </div>

            </div>

          </div>

        </div>

      </div>


      <!-- =====================================================
           SLIDE 2
      ====================================================== -->

      <div class="carousel-item">

        <div
          class="container-fluid"
          style="
            min-height: 620px;
            background:
              linear-gradient(
                90deg,
                rgba(0,0,0,.90),
                rgba(0,0,0,.60),
                rgba(0,0,0,.25)
              ),
              url('/assets/img/slider-2.jpg')
              center/cover;
          ">

          <div
            class="container d-flex align-items-center"
            style="min-height: 620px;">

            <div class="row w-100">

              <div class="col-lg-7">

                <span class="badge bg-success mb-3 px-3 py-2">
                  EMPRESAS Y TALENTO UNIVERSITARIO
                </span>

                <h2 class="display-4 fw-bold mb-4">
                  Conecta con
                  <span class="text-success">
                    nuevos talentos
                  </span>
                </h2>

                <p class="lead mb-4">
                  Encuentra estudiantes con las habilidades,
                  conocimientos y formación que tu empresa necesita.
                </p>

                <a
                  href="/empresas"
                  class="btn btn-success btn-lg px-4">

                  <i class="fa-solid fa-building me-2"></i>
                  Conocer empresas

                </a>

              </div>

            </div>

          </div>

        </div>

      </div>


      <!-- =====================================================
           SLIDE 3
      ====================================================== -->

      <div class="carousel-item">

        <div
          class="container-fluid"
          style="
            min-height: 620px;
            background:
              linear-gradient(
                90deg,
                rgba(0,0,0,.90),
                rgba(0,0,0,.60),
                rgba(0,0,0,.25)
              ),
              url('/assets/img/slider-3.jpg')
              center/cover;
          ">

          <div
            class="container d-flex align-items-center"
            style="min-height: 620px;">

            <div class="row w-100">

              <div class="col-lg-7">

                <span class="badge bg-success mb-3 px-3 py-2">
                  BÚSQUEDA INTELIGENTE
                </span>

                <h2 class="display-4 fw-bold mb-4">
                  Encuentra ofertas
                  <span class="text-success">
                    que encajen contigo
                  </span>
                </h2>

                <p class="lead mb-4">
                  Filtra oportunidades por carrera, habilidades,
                  modalidad, ubicación y jornada laboral.
                </p>

                <a
                  href="/convocatorias"
                  class="btn btn-success btn-lg px-4">

                  <i class="fa-solid fa-magnifying-glass me-2"></i>
                  Buscar oportunidades

                </a>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>


    <!-- Controles -->

    <button
      class="carousel-control-prev"
      type="button"
      data-bs-target="#heroCarousel"
      data-bs-slide="prev">

      <span class="carousel-control-prev-icon"></span>

      <span class="visually-hidden">
        Anterior
      </span>

    </button>


    <button
      class="carousel-control-next"
      type="button"
      data-bs-target="#heroCarousel"
      data-bs-slide="next">

      <span class="carousel-control-next-icon"></span>

      <span class="visually-hidden">
        Siguiente
      </span>

    </button>

  </div>

</section>



<!-- =========================================================
     BUSCADOR RÁPIDO DE OFERTAS
========================================================= -->

<section class="bg-light py-5">

  <div class="container">

    <div class="text-center mb-4">

      <span class="text-success fw-bold text-uppercase">
        Encuentra oportunidades
      </span>

      <h2 class="fw-bold mt-2">
        Busca tu próxima práctica
      </h2>

      <p class="text-muted">
        Encuentra ofertas de prácticas según tu carrera,
        habilidades y preferencias.
      </p>

    </div>


    <div class="card border-0 shadow-sm">

      <div class="card-body p-4">

        <form
          action="/convocatorias"
          method="GET">

          <div class="row g-3">

            <!-- Buscar -->
            <div class="col-12 col-lg-4">

              <label class="form-label fw-semibold">
                ¿Qué estás buscando?
              </label>

              <div class="input-group">

                <span class="input-group-text bg-white">
                  <i class="fa-solid fa-magnifying-glass"></i>
                </span>

                <input
                  type="text"
                  class="form-control"
                  name="search"
                  placeholder="Ej. Marketing, desarrollo, finanzas...">

              </div>

            </div>


            <!-- Modalidad -->
            <div class="col-12 col-md-4 col-lg-2">

              <label class="form-label fw-semibold">
                Modalidad
              </label>

              <select
                name="modality"
                class="form-select">

                <option value="">
                  Todas
                </option>

                <option value="presencial">
                  Presencial
                </option>

                <option value="remoto">
                  Remoto
                </option>

                <option value="hibrido">
                  Híbrido
                </option>

              </select>

            </div>


            <!-- Jornada -->
            <div class="col-12 col-md-4 col-lg-2">

              <label class="form-label fw-semibold">
                Jornada
              </label>

              <select
                name="workday"
                class="form-select">

                <option value="">
                  Todas
                </option>

                <option value="part-time">
                  Part-time
                </option>

                <option value="full-time">
                  Full-time
                </option>

              </select>

            </div>


            <!-- Ubicación -->
            <div class="col-12 col-md-4 col-lg-2">

              <label class="form-label fw-semibold">
                Ubicación
              </label>

              <select
                name="district"
                class="form-select">

                <option value="">
                  Todas
                </option>

                <option value="miraflores">
                  Miraflores
                </option>

                <option value="san-isidro">
                  San Isidro
                </option>

                <option value="surco">
                  Surco
                </option>

                <option value="la-molina">
                  La Molina
                </option>

              </select>

            </div>


            <!-- Botón -->
            <div class="col-12 col-lg-2 d-flex align-items-end">

              <button
                type="submit"
                class="btn btn-success w-100">

                <i class="fa-solid fa-magnifying-glass me-2"></i>
                Buscar

              </button>

            </div>

          </div>

        </form>

      </div>

    </div>

  </div>

</section>



<!-- =========================================================
     ESTADÍSTICAS
========================================================= -->

<section class="py-5">

  <div class="container">

    <div class="text-center mb-5">

      <span class="text-success fw-bold text-uppercase">
        PRÁCTICA LIMA
      </span>

      <h2 class="fw-bold mt-2">
        Una plataforma para conectar talento
      </h2>

      <p class="text-muted">
        Conoce las oportunidades disponibles en nuestra plataforma.
      </p>

    </div>


    <div class="row g-4">


      <!-- Ofertas -->
      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-success bg-opacity-10
                     text-success rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;">

              <i class="fa-solid fa-briefcase fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">

              <%= typeof applicationCount !== 'undefined'
                ? applicationCount
                : '100+' %>

            </h3>

            <p class="text-muted mb-0">
              Ofertas laborales
            </p>

          </div>

        </div>

      </div>


      <!-- Empresas -->
      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-primary bg-opacity-10
                     text-primary rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;">

              <i class="fa-solid fa-building fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">

              <%= typeof enterpriseCount !== 'undefined'
                ? enterpriseCount
                : '50+' %>

            </h3>

            <p class="text-muted mb-0">
              Empresas
            </p>

          </div>

        </div>

      </div>


      <!-- Estudiantes -->
      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-warning bg-opacity-10
                     text-warning rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;">

              <i class="fa-solid fa-user-graduate fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">

              <%= typeof studentCount !== 'undefined'
                ? studentCount
                : '500+' %>

            </h3>

            <p class="text-muted mb-0">
              Estudiantes
            </p>

          </div>

        </div>

      </div>


      <!-- Carreras -->
      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-danger bg-opacity-10
                     text-danger rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;">

              <i class="fa-solid fa-graduation-cap fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">

              <%= typeof careerCount !== 'undefined'
                ? careerCount
                : '20+' %>

            </h3>

            <p class="text-muted mb-0">
              Carreras
            </p>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>



<!-- =========================================================
     CÓMO FUNCIONA
========================================================= -->

<section
  id="como-funciona"
  class="bg-light py-5">

  <div class="container">

    <div class="text-center mb-5">

      <span class="text-success fw-bold text-uppercase">
        CÓMO FUNCIONA
      </span>

      <h2 class="fw-bold mt-2">
        Encuentra tu práctica en pocos pasos
      </h2>

      <p class="text-muted">
        Todo lo que necesitas para comenzar tu experiencia profesional.
      </p>

    </div>


    <div class="row g-4">


      <!-- Paso 1 -->
      <div class="col-md-4">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-success text-white rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-4"
              style="width:70px;height:70px;">

              <span class="fs-3 fw-bold">
                1
              </span>

            </div>

            <h5 class="fw-bold">
              Crea tu perfil
            </h5>

            <p class="text-muted mb-0">
              Regístrate y completa tu información académica,
              habilidades y experiencia.
            </p>

          </div>

        </div>

      </div>


      <!-- Paso 2 -->
      <div class="col-md-4">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-success text-white rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-4"
              style="width:70px;height:70px;">

              <span class="fs-3 fw-bold">
                2
              </span>

            </div>

            <h5 class="fw-bold">
              Encuentra una oportunidad
            </h5>

            <p class="text-muted mb-0">
              Explora las ofertas y utiliza los filtros
              para encontrar las que mejor se adapten a tu perfil.
            </p>

          </div>

        </div>

      </div>


      <!-- Paso 3 -->
      <div class="col-md-4">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-success text-white rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-4"
              style="width:70px;height:70px;">

              <span class="fs-3 fw-bold">
                3
              </span>

            </div>

            <h5 class="fw-bold">
              Postúlate
            </h5>

            <p class="text-muted mb-0">
              Envía tu postulación y realiza el seguimiento
              del proceso directamente desde la plataforma.
            </p>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>



<!-- =========================================================
     SOBRE LA PLATAFORMA
========================================================= -->

<section
  id="about"
  class="bg-dark text-white py-5">

  <div class="container">

    <div class="row align-items-center g-5">


      <!-- Texto -->
      <div class="col-lg-6">

        <span class="badge bg-success mb-3">
          SOBRE PRÁCTICA LIMA
        </span>

        <h2 class="display-6 fw-bold mb-4">
          El siguiente paso de tu
          <span class="text-success">
            desarrollo profesional
          </span>
        </h2>

        <p class="text-light lead">
          Práctica Lima conecta estudiantes universitarios
          con empresas que buscan jóvenes talentos para
          sus oportunidades de prácticas.
        </p>

        <p class="text-secondary">
          Crea tu perfil, muestra tus habilidades, descubre
          oportunidades relacionadas con tu carrera y
          realiza un seguimiento de tus postulaciones.
        </p>

        <a
          href="/convocatorias"
          class="btn btn-success mt-3">

          <i class="fa-solid fa-briefcase me-2"></i>
          Explorar ofertas

        </a>

      </div>


      <!-- Características -->
      <div class="col-lg-6">

        <div class="row g-3">


          <!-- Perfil -->
          <div class="col-6">

            <div
              class="card bg-secondary bg-opacity-10
                     border-secondary h-100">

              <div class="card-body p-4">

                <i
                  class="fa-solid fa-user-graduate
                         text-success fs-1">
                </i>

                <h5 class="mt-3">
                  Perfil profesional
                </h5>

                <p class="text-secondary small mb-0">
                  Presenta tu formación, habilidades
                  y experiencia.
                </p>

              </div>

            </div>

          </div>


          <!-- Ofertas -->
          <div class="col-6">

            <div
              class="card bg-secondary bg-opacity-10
                     border-secondary h-100">

              <div class="card-body p-4">

                <i
                  class="fa-solid fa-briefcase
                         text-success fs-1">
                </i>

                <h5 class="mt-3">
                  Ofertas laborales
                </h5>

                <p class="text-secondary small mb-0">
                  Descubre oportunidades según
                  tus intereses.
                </p>

              </div>

            </div>

          </div>


          <!-- Habilidades -->
          <div class="col-6">

            <div
              class="card bg-secondary bg-opacity-10
                     border-secondary h-100">

              <div class="card-body p-4">

                <i
                  class="fa-solid fa-star
                         text-success fs-1">
                </i>

                <h5 class="mt-3">
                  Habilidades
                </h5>

                <p class="text-secondary small mb-0">
                  Destaca tus conocimientos y
                  niveles de habilidad.
                </p>

              </div>

            </div>

          </div>


          <!-- Seguimiento -->
          <div class="col-6">

            <div
              class="card bg-secondary bg-opacity-10
                     border-secondary h-100">

              <div class="card-body p-4">

                <i
                  class="fa-solid fa-chart-line
                         text-success fs-1">
                </i>

                <h5 class="mt-3">
                  Seguimiento
                </h5>

                <p class="text-secondary small mb-0">
                  Consulta el estado de tus
                  postulaciones.
                </p>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>



<!-- =========================================================
     CTA ESTUDIANTE / EMPRESA
========================================================= -->

<section class="py-5">

  <div class="container">

    <div class="row g-4">


      <!-- Estudiante -->
      <div class="col-lg-6">

        <div
          class="bg-success rounded-4 p-5
                 text-white h-100">

          <i class="fa-solid fa-user-graduate fs-1"></i>

          <h2 class="fw-bold mt-3">
            ¿Buscas una práctica?
          </h2>

          <p class="lead mb-4">
            Crea tu perfil y descubre oportunidades
            que se adapten a tu carrera y habilidades.
          </p>

          <a
            href="/register"
            class="btn btn-light btn-lg px-4">

            <i class="fa-solid fa-user-plus me-2"></i>
            Crear cuenta

          </a>

        </div>

      </div>


      <!-- Empresa -->
      <div class="col-lg-6">

        <div
          class="bg-dark rounded-4 p-5
                 text-white h-100">

          <i class="fa-solid fa-building fs-1 text-success"></i>

          <h2 class="fw-bold mt-3">
            ¿Buscas talento?
          </h2>

          <p class="lead text-light mb-4">
            Registra tu empresa y encuentra estudiantes
            preparados para formar parte de tu equipo.
          </p>

          <a
            href="/register"
            class="btn btn-success btn-lg px-4">

            <i class="fa-solid fa-building me-2"></i>
            Registrar empresa

          </a>

        </div>

      </div>

    </div>

  </div>

</section>



<!-- =========================================================
     CTA FINAL
========================================================= -->

<section class="py-5">

  <div class="container">

    <div
      class="bg-light border rounded-4
             p-5 text-center">

      <i
        class="fa-solid fa-rocket
               text-success fs-1">
      </i>

      <h2 class="fw-bold mt-3">
        Tu próxima oportunidad puede estar aquí
      </h2>

      <p class="lead text-muted mb-4">
        Explora las ofertas disponibles y comienza
        a construir tu experiencia profesional.
      </p>

      <a
        href="/convocatorias"
        class="btn btn-success btn-lg px-5">

        <i class="fa-solid fa-magnifying-glass me-2"></i>
        Explorar ofertas

      </a>

    </div>

  </div>

</section>