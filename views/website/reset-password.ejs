<!-- views\website\reset-password.ejs -->

<% layout("layouts/access") %>

<div class="login-form bg-white bg-opacity-90 p-5 mt-5">

  <!-- Logo -->
  <div class="text-center mb-4">
    <img
      src="/assets/img/ulimaLogo.png"
      width="203"
      height="50"
      alt="Universidad de Lima"
    >
  </div>

  <!-- Título -->
  <div class="text-center mb-4">
    <h4>Recuperar contraseña</h4>

    <p class="text-muted small mb-0">
      Ingresa tu correo electrónico para recibir las
      instrucciones para recuperar tu contraseña.
    </p>
  </div>

  <!-- Correo -->
  <div class="mb-3">
    <label for="txtEmail" class="form-label">
      Correo electrónico
    </label>

    <input
      class="form-control"
      type="email"
      name="email"
      id="txtEmail"
      placeholder="Ingrese su correo electrónico"
      autocomplete="email"
      required
    >
  </div>

  <!-- Botón -->
  <div class="d-grid mb-3">
    <button type="button" class="btn btn-dark">
      Recuperar contraseña
    </button>
  </div>

  <!-- Volver al login -->
  <div class="text-center mb-4">
    <a href="/login">
      Volver al inicio de sesión
    </a>
  </div>

  <!-- Copyright -->
  <div class="text-center">
    <small class="text-muted">
      © 1997-2026 Blackboard Inc. Todos los derechos reservados.
    </small>
  </div>

</div>
