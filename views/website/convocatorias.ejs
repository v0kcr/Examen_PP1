<!-- views/convocatorias.ejs -->

<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0">

  <title>Ofertas laborales | Práctica Lima</title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">

  <!-- Font Awesome -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

  <style>

    body {
      background-color: #f8f9fa;
    }

    .page-header {
      background:
        linear-gradient(
          135deg,
          #212529 0%,
          #343a40 100%
        );
      color: white;
      padding: 70px 0;
    }

    .page-header .badge {
      font-weight: 500;
    }

    .search-box {
      margin-top: -35px;
      position: relative;
      z-index: 10;
    }

    .search-card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, .08);
    }

    .filter-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, .05);
    }

    .filter-title {
      font-size: .85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .offer-card {
      border: 1px solid #e9ecef;
      border-radius: 14px;
      transition: all .2s ease;
      background: white;
    }

    .offer-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, .08);
      border-color: #198754;
    }

    .company-logo {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      font-weight: 700;
    }

    .offer-title {
      color: #212529;
      font-weight: 700;
      text-decoration: none;
    }

    .offer-title:hover {
      color: #198754;
    }

    .offer-meta {
      color: #6c757d;
      font-size: .9rem;
    }

    .skill-badge {
      background-color: #f1f3f5;
      color: #495057;
      font-weight: 500;
      padding: 6px 10px;
      border-radius: 20px;
      font-size: .78rem;
    }

    .salary {
      color: #198754;
      font-weight: 700;
    }

    .pagination .page-link {
      color: #198754;
    }

    .pagination .active .page-link {
      background-color: #198754;
      border-color: #198754;
      color: white;
    }

  </style>

</head>


<body>


  <!-- ========================= -->
  <!-- NAVBAR -->
  <!-- ========================= -->

  <%- include('partials/_navbar') %>


  <!-- ========================= -->
  <!-- HEADER -->
  <!-- ========================= -->

  <header class="page-header">

    <div class="container">

      <div class="row">

        <div class="col-lg-8">

          <span class="badge bg-success-subtle text-success mb-3 px-3 py-2">
            <i class="fa-solid fa-briefcase me-1"></i>
            Oportunidades para estudiantes
          </span>

          <h1 class="display-5 fw-bold mb-3">
            Encuentra tu próxima oportunidad
          </h1>

          <p class="lead text-white-50 mb-0">
            Explora prácticas pre-profesionales y encuentra
            una oportunidad que se adapte a tu carrera,
            habilidades y objetivos profesionales.
          </p>

        </div>

      </div>

    </div>

  </header>


  <!-- ========================= -->
  <!-- SEARCH -->
  <!-- ========================= -->

  <section class="search-box">

    <div class="container">

      <div class="card search-card">

        <div class="card-body p-4">

          <div class="row g-3 align-items-end">

            <!-- Search -->
            <div class="col-lg-5">

              <label class="form-label fw-semibold">
                ¿Qué estás buscando?
              </label>

              <div class="input-group">

                <span class="input-group-text bg-white">
                  <i class="fa-solid fa-magnifying-glass text-secondary"></i>
                </span>

                <input
                  type="text"
                  class="form-control"
                  placeholder="Cargo, habilidad o palabra clave">

              </div>

            </div>


            <!-- Location -->
            <div class="col-lg-3">

              <label class="form-label fw-semibold">
                Ubicación
              </label>

              <select class="form-select">

                <option selected>
                  Todas las ubicaciones
                </option>

                <option>
                  Lima
                </option>

                <option>
                  Miraflores
                </option>

                <option>
                  San Isidro
                </option>

                <option>
                  Surco
                </option>

                <option>
                  San Borja
                </option>

              </select>

            </div>


            <!-- Modality -->
            <div class="col-lg-2">

              <label class="form-label fw-semibold">
                Modalidad
              </label>

              <select class="form-select">

                <option selected>
                  Todas
                </option>

                <option>
                  Presencial
                </option>

                <option>
                  Híbrido
                </option>

                <option>
                  Remoto
                </option>

              </select>

            </div>


            <!-- Button -->
            <div class="col-lg-2">

              <button
                type="button"
                class="btn btn-success w-100">

                <i class="fa-solid fa-magnifying-glass me-1"></i>

                Buscar

              </button>

            </div>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- ========================= -->
  <!-- OFFERS -->
  <!-- ========================= -->

  <main class="container py-5">

    <div class="row g-4">


      <!-- ========================= -->
      <!-- FILTERS -->
      <!-- ========================= -->

      <aside class="col-lg-3">

        <div class="card filter-card">

          <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">

              <h5 class="fw-bold mb-0">
                Filtros
              </h5>

              <a
                href="#"
                class="small text-success text-decoration-none">

                Limpiar

              </a>

            </div>


            <!-- Career -->
            <div class="mb-4">

              <div class="filter-title mb-3">
                Carrera
              </div>

              <div class="form-check mb-2">

                <input
                  class="form-check-input"
                  type="checkbox"
                  id="sistemas">

                <label
                  class="form-check-label"
                  for="sistemas">

                  Ingeniería de Sistemas

                </label>

              </div>

              <div class="form-check mb-2">

                <input
                  class="form-check-input"
                  type="checkbox"
                  id="industrial">

                <label
                  class="form-check-label"
                  for="industrial">

                  Ingeniería Industrial

                </label>

              </div>

              <div class="form-check mb-2">

                <input
                  class="form-check-input"
                  type="checkbox"
                  id="marketing">

                <label
                  class="form-check-label"
                  for="marketing">

                  Marketing

                </label>

              </div>

              <div class="form-check mb-2">

                <input
                  class="form-check-input"
                  type="checkbox"
                  id="administracion">

                <label
                  class="form-check-label"
                  for="administracion">

                  Administración

                </label>

              </div>

              <div class="form-check">

                <input
                  class="form-check-input"
                  type="checkbox"
                  id="economia">

                <label
                  class="form-check-label"
                  for="economia">

                  Economía

                </label>

              </div>

            </div>


            <!-- Modality -->
            <div class="mb-4">

              <div class="filter-title mb-3">
                Modalidad
              </div>

              <div class="form-check mb-2">

                <input
                  class="form-check-input"
                  type="checkbox"
                  id="presencial">

                <label
                  class="form-check-label"
                  for="presencial">

                  Presencial

                </label>

              </div>

              <div class="form-check mb-2">

                <input
                  class="form-check-input"
                  type="checkbox"
                  id="hibrido">

                <label
                  class="form-check-label"
                  for="hibrido">

                  Híbrido

                </label>

              </div>

              <div class="form-check">

                <input
                  class="form-check-input"
                  type="checkbox"
                  id="remoto">

                <label
                  class="form-check-label"
                  for="remoto">

                  Remoto

                </label>

              </div>

            </div>


            <!-- Workday -->
            <div class="mb-4">

              <div class="filter-title mb-3">
                Jornada
              </div>

              <div class="form-check mb-2">

                <input
                  class="form-check-input"
                  type="checkbox"
                  id="part-time">

                <label
                  class="form-check-label"
                  for="part-time">

                  Part time

                </label>

              </div>

              <div class="form-check">

                <input
                  class="form-check-input"
                  type="checkbox"
                  id="full-time">

                <label
                  class="form-check-label"
                  for="full-time">

                  Full time

                </label>

              </div>

            </div>


            <!-- Salary -->
            <div>

              <div class="filter-title mb-3">
                Remuneración
              </div>

              <div class="form-check mb-2">

                <input
                  class="form-check-input"
                  type="checkbox"
                  id="salary1">

                <label
                  class="form-check-label"
                  for="salary1">

                  Hasta S/ 600

                </label>

              </div>

              <div class="form-check mb-2">

                <input
                  class="form-check-input"
                  type="checkbox"
                  id="salary2">

                <label
                  class="form-check-label"
                  for="salary2">

                  S/ 600 – S/ 1,000

                </label>

              </div>

              <div class="form-check">

                <input
                  class="form-check-input"
                  type="checkbox"
                  id="salary3">

                <label
                  class="form-check-label"
                  for="salary3">

                  Más de S/ 1,000

                </label>

              </div>

            </div>

          </div>

        </div>

      </aside>


      <!-- ========================= -->
      <!-- RESULTS -->
      <!-- ========================= -->

      <section class="col-lg-9">


        <!-- Results header -->
        <div
          class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

          <div>

            <h4 class="fw-bold mb-1">
              Ofertas disponibles
            </h4>

            <p class="text-secondary mb-0">
              24 oportunidades encontradas
            </p>

          </div>


          <div class="mt-3 mt-md-0">

            <select
              class="form-select form-select-sm">

              <option selected>
                Más recientes
              </option>

              <option>
                Mejor coincidencia
              </option>

              <option>
                Mayor remuneración
              </option>

            </select>

          </div>

        </div>


        <!-- ========================= -->
        <!-- OFFER 1 -->
        <!-- ========================= -->

        <div class="card offer-card mb-3">

          <div class="card-body p-4">

            <div class="row">

              <div class="col-auto">

                <div
                  class="company-logo bg-primary-subtle text-primary">

                  <i class="fa-solid fa-code"></i>

                </div>

              </div>


              <div class="col">

                <div
                  class="d-flex justify-content-between gap-3">

                  <div>

                    <a
                      href="/convocatorias/1"
                      class="offer-title fs-5">

                      Practicante de Desarrollo de Software

                    </a>

                    <div class="text-secondary mt-1">

                      <i class="fa-solid fa-building me-1"></i>
                      TechSolutions Perú

                    </div>

                  </div>


                  <button
                    type="button"
                    class="btn btn-light rounded-circle"
                    title="Guardar oferta">

                    <i class="fa-regular fa-bookmark"></i>

                  </button>

                </div>


                <div
                  class="d-flex flex-wrap gap-3 offer-meta mt-3">

                  <span>
                    <i class="fa-solid fa-location-dot me-1"></i>
                    San Isidro
                  </span>

                  <span>
                    <i class="fa-solid fa-house-laptop me-1"></i>
                    Híbrido
                  </span>

                  <span>
                    <i class="fa-solid fa-clock me-1"></i>
                    Part time
                  </span>

                  <span class="salary">
                    <i class="fa-solid fa-money-bill-wave me-1"></i>
                    S/ 1,000
                  </span>

                </div>


                <div class="mt-3">

                  <span class="skill-badge me-1">
                    Java
                  </span>

                  <span class="skill-badge me-1">
                    SQL
                  </span>

                  <span class="skill-badge me-1">
                    Git
                  </span>

                  <span class="skill-badge">
                    APIs REST
                  </span>

                </div>


                <div class="text-secondary small mt-3">

                  <i class="fa-regular fa-clock me-1"></i>

                  Publicado hace 2 días

                </div>

              </div>

            </div>

          </div>

        </div>


        <!-- ========================= -->
        <!-- OFFER 2 -->
        <!-- ========================= -->

        <div class="card offer-card mb-3">

          <div class="card-body p-4">

            <div class="row">

              <div class="col-auto">

                <div
                  class="company-logo bg-success-subtle text-success">

                  <i class="fa-solid fa-chart-line"></i>

                </div>

              </div>


              <div class="col">

                <div
                  class="d-flex justify-content-between gap-3">

                  <div>

                    <a
                      href="/convocatorias/2"
                      class="offer-title fs-5">

                      Practicante de Marketing Digital

                    </a>

                    <div class="text-secondary mt-1">

                      <i class="fa-solid fa-building me-1"></i>
                      Grupo Innovación

                    </div>

                  </div>


                  <button
                    type="button"
                    class="btn btn-light rounded-circle">

                    <i class="fa-regular fa-bookmark"></i>

                  </button>

                </div>


                <div
                  class="d-flex flex-wrap gap-3 offer-meta mt-3">

                  <span>
                    <i class="fa-solid fa-location-dot me-1"></i>
                    Miraflores
                  </span>

                  <span>
                    <i class="fa-solid fa-house-laptop me-1"></i>
                    Híbrido
                  </span>

                  <span>
                    <i class="fa-solid fa-clock me-1"></i>
                    Part time
                  </span>

                  <span class="salary">
                    <i class="fa-solid fa-money-bill-wave me-1"></i>
                    S/ 850
                  </span>

                </div>


                <div class="mt-3">

                  <span class="skill-badge me-1">
                    Marketing Digital
                  </span>

                  <span class="skill-badge me-1">
                    Google Ads
                  </span>

                  <span class="skill-badge">
                    Analytics
                  </span>

                </div>


                <div class="text-secondary small mt-3">

                  <i class="fa-regular fa-clock me-1"></i>

                  Publicado hace 3 días

                </div>

              </div>

            </div>

          </div>

        </div>


        <!-- ========================= -->
        <!-- OFFER 3 -->
        <!-- ========================= -->

        <div class="card offer-card mb-3">

          <div class="card-body p-4">

            <div class="row">

              <div class="col-auto">

                <div
                  class="company-logo bg-warning-subtle text-warning">

                  <i class="fa-solid fa-industry"></i>

                </div>

              </div>


              <div class="col">

                <div
                  class="d-flex justify-content-between gap-3">

                  <div>

                    <a
                      href="/convocatorias/3"
                      class="offer-title fs-5">

                      Practicante de Procesos

                    </a>

                    <div class="text-secondary mt-1">

                      <i class="fa-solid fa-building me-1"></i>
                      Corporación Andina

                    </div>

                  </div>


                  <button
                    type="button"
                    class="btn btn-light rounded-circle">

                    <i class="fa-regular fa-bookmark"></i>

                  </button>

                </div>


                <div
                  class="d-flex flex-wrap gap-3 offer-meta mt-3">

                  <span>
                    <i class="fa-solid fa-location-dot me-1"></i>
                    Surco
                  </span>

                  <span>
                    <i class="fa-solid fa-building me-1"></i>
                    Presencial
                  </span>

                  <span>
                    <i class="fa-solid fa-clock me-1"></i>
                    Part time
                  </span>

                  <span class="salary">
                    <i class="fa-solid fa-money-bill-wave me-1"></i>
                    S/ 750
                  </span>

                </div>


                <div class="mt-3">

                  <span class="skill-badge me-1">
                    Excel
                  </span>

                  <span class="skill-badge me-1">
                    Power BI
                  </span>

                  <span class="skill-badge">
                    Procesos
                  </span>

                </div>


                <div class="text-secondary small mt-3">

                  <i class="fa-regular fa-clock me-1"></i>

                  Publicado hace 5 días

                </div>

              </div>

            </div>

          </div>

        </div>


        <!-- ========================= -->
        <!-- OFFER 4 -->
        <!-- ========================= -->

        <div class="card offer-card mb-3">

          <div class="card-body p-4">

            <div class="row">

              <div class="col-auto">

                <div
                  class="company-logo bg-danger-subtle text-danger">

                  <i class="fa-solid fa-coins"></i>

                </div>

              </div>


              <div class="col">

                <div
                  class="d-flex justify-content-between gap-3">

                  <div>

                    <a
                      href="/convocatorias/4"
                      class="offer-title fs-5">

                      Practicante de Finanzas

                    </a>

                    <div class="text-secondary mt-1">

                      <i class="fa-solid fa-building me-1"></i>
                      Inversiones del Pacífico

                    </div>

                  </div>


                  <button
                    type="button"
                    class="btn btn-light rounded-circle">

                    <i class="fa-regular fa-bookmark"></i>

                  </button>

                </div>


                <div
                  class="d-flex flex-wrap gap-3 offer-meta mt-3">

                  <span>
                    <i class="fa-solid fa-location-dot me-1"></i>
                    San Borja
                  </span>

                  <span>
                    <i class="fa-solid fa-house-laptop me-1"></i>
                    Híbrido
                  </span>

                  <span>
                    <i class="fa-solid fa-clock me-1"></i>
                    Part time
                  </span>

                  <span class="salary">
                    <i class="fa-solid fa-money-bill-wave me-1"></i>
                    S/ 1,100
                  </span>

                </div>


                <div class="mt-3">

                  <span class="skill-badge me-1">
                    Excel
                  </span>

                  <span class="skill-badge me-1">
                    Finanzas
                  </span>

                  <span class="skill-badge">
                    SAP
                  </span>

                </div>


                <div class="text-secondary small mt-3">

                  <i class="fa-regular fa-clock me-1"></i>

                  Publicado hace 1 semana

                </div>

              </div>

            </div>

          </div>

        </div>


        <!-- ========================= -->
        <!-- PAGINATION -->
        <!-- ========================= -->

        <nav
          class="mt-5"
          aria-label="Paginación de convocatorias">

          <ul class="pagination justify-content-center">

            <li class="page-item disabled">

              <a
                class="page-link"
                href="#">

                <i class="fa-solid fa-chevron-left"></i>

              </a>

            </li>

            <li class="page-item active">

              <a
                class="page-link"
                href="#">

                1

              </a>

            </li>

            <li class="page-item">

              <a
                class="page-link"
                href="#">

                2

              </a>

            </li>

            <li class="page-item">

              <a
                class="page-link"
                href="#">

                3

              </a>

            </li>

            <li class="page-item">

              <a
                class="page-link"
                href="#">

                <i class="fa-solid fa-chevron-right"></i>

              </a>

            </li>

          </ul>

        </nav>

      </section>

    </div>

  </main>


  <!-- ========================= -->
  <!-- FOOTER -->
  <!-- ========================= -->

  <%- include('partials/_footer') %>


  <!-- Bootstrap JS -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
  </script>

</body>

</html>