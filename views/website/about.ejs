<!-- views/website/about.ejs -->
<% layout("layouts/website") %>
<section
  class="relative flex min-h-[500px] items-center justify-center bg-fixed bg-cover bg-center"
  style="background-image: url('/images/stadium.jpg');"
>

  <!-- Overlay -->
  <div class="absolute inset-0 bg-primary/70"></div>


  <!-- Contenido -->
  <div class="relative z-10 mx-auto max-w-4xl px-6 text-center text-white">

    <h1 class="mb-6 text-5xl font-bold">
      Nosotros
    </h1>

    <p class="text-lg leading-relaxed">
      ULima FIFA es una plataforma creada para administrar y gestionar
      información de jugadores, equipos y competencias universitarias.
      Nuestro objetivo es centralizar estadísticas, perfiles y datos
      relevantes del mundo FIFA dentro de nuestra comunidad.
    </p>

  </div>

</section>


<section class="bg-white px-8 py-16">

  <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-3">

    <div class="rounded-xl p-6 text-center shadow">
      <i class="fa-solid fa-bullseye mb-4 text-4xl text-primary"></i>

      <h2 class="mb-2 text-xl font-bold">
        Misión
      </h2>

      <p class="text-gray-600">
        Crear una plataforma sencilla para gestionar jugadores,
        estadísticas y competencias.
      </p>
    </div>


    <div class="rounded-xl p-6 text-center shadow">

      <i class="fa-solid fa-eye mb-4 text-4xl text-primary"></i>

      <h2 class="mb-2 text-xl font-bold">
        Visión
      </h2>

      <p class="text-gray-600">
        Ser una herramienta completa para la comunidad FIFA universitaria.
      </p>

    </div>


    <div class="rounded-xl p-6 text-center shadow">

      <i class="fa-solid fa-users mb-4 text-4xl text-primary"></i>

      <h2 class="mb-2 text-xl font-bold">
        Comunidad
      </h2>

      <p class="text-gray-600">
        Conectar jugadores y equipos mediante información organizada.
      </p>

    </div>

  </div>

</section>