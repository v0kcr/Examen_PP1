<!DOCTYPE html>

<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <link
    rel="icon"
    type="image/x-icon"
    href="/favicon.ico"
  >

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Font Awesome 7.3.1 -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
  >

  <!-- CSS propio -->
  <link
    rel="stylesheet"
    href="/dist/css/web.css"
  >

  <title>401 | Acceso no autorizado | PlayerStats</title>

</head>


<body class="bg-dark min-vh-100 d-flex flex-column">


  <!-- =====================================================
       CONTENIDO
  ====================================================== -->

  <main class="flex-grow-1 d-flex align-items-center justify-content-center p-4">

    <div
      class="container"
      style="max-width: 900px;">

      <div class="row justify-content-center">

        <div class="col-12 col-md-10 col-lg-8">

          <div
            class="card bg-dark border-secondary shadow-lg text-center">

            <div class="card-body p-4 p-md-5">


              <!-- Icono -->
              <div class="mb-4">

                <div
                  class="d-inline-flex
                         align-items-center
                         justify-content-center
                         rounded-circle
                         bg-success
                         bg-opacity-10
                         text-success"
                  style="width: 100px; height: 100px;">

                  <i
                    class="fa-solid fa-lock"
                    style="font-size: 3rem;">
                  </i>

                </div>

              </div>


              <!-- Código -->
              <h1
                class="display-1 fw-bold text-success mb-0"
                style="font-size: clamp(6rem, 18vw, 12rem);">

                401

              </h1>


              <!-- Título -->
              <h2 class="display-6 fw-bold text-white mt-3">

                Acceso no autorizado

              </h2>


              <!-- Mensaje -->
              <p
                class="lead text-secondary mx-auto mt-3"
                style="max-width: 600px;">

                <%= message || 'Debes iniciar sesión para acceder a esta página.' %>

              </p>


              <!-- Botones -->
              <div
                class="d-flex
                       flex-column
                       flex-sm-row
                       justify-content-center
                       gap-2
                       mt-4">


                <!-- Login -->
                <a
                  href="/sign-in"
                  class="btn btn-success btn-lg px-4">

                  <i class="fa-solid fa-right-to-bracket me-2"></i>

                  Iniciar sesión

                </a>


                <!-- Inicio -->
                <a
                  href="/"
                  class="btn btn-outline-light btn-lg px-4">

                  <i class="fa-solid fa-house me-2"></i>

                  Volver al inicio

                </a>

              </div>


              <!-- Información -->
              <div class="mt-5 pt-4 border-top border-secondary">

                <div
                  class="d-flex
                         align-items-center
                         justify-content-center
                         text-secondary">

                  <i
                    class="fa-solid fa-shield-halved text-success me-2">
                  </i>

                  <span class="small">

                    PlayerStats · FIFA / EA FC Player Database

                  </span>

                </div>

              </div>


            </div>

          </div>

        </div>

      </div>

    </div>

  </main>


  <!-- =====================================================
       FOOTER
  ====================================================== -->

  <footer class="border-top border-secondary py-3">

    <div class="container text-center">

      <p class="text-secondary small mb-0">

        © 2026 PlayerStats.
        Todos los derechos reservados.

      </p>

    </div>

  </footer>


</body>

</html>