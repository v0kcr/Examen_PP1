<!-- views/admin/carrers.ejs -->

<% layout("layouts/admin2") %>

<main class="main-content"> <div class="container-fluid">
<!-- PAGE HEADER -->
<h3 class="mb-4">
  <a href="/admin/academic">
    <i class="fa fa-book me-2"></i>
    Gestión Académica
  </a>
  / Carreras
</h3>

<div class="row">

  <!-- ========================= -->
  <!-- FORMULARIO -->
  <!-- ========================= -->
  <div class="col-lg-4 col-md-5 mb-4">

    <div class="card">

      <div class="card-header">
        <h6 class="mb-0" id="cardTitle">
          <i class="fa fa-plus me-2"></i>
          Nueva Carrera
        </h6>
      </div>

      <div class="card-body">

        <form method="POST" action="/carrers">

          <div class="mb-3">

            <label for="name" class="form-label">
              Nombre
            </label>

            <input type="hidden" name="" id="carrerId">

            <input
              type="text"
              id="name"
              name="name"
              class="form-control"
              placeholder="Ingrese el nombre de la carrera..."
              required
            >
          </div>

          <div class="mb-3">

            <label for="creditos" class="form-label">
              Creditos
            </label>

            <input
              type="text"
              id="creditos"
              name="creditos"
              class="form-control"
              placeholder=""
              required
            >
          </div>

          <div class="mb-3">

            <label for="semestre" class="form-label">
              Semestre
            </label>

            <input
              type="text"
              id="semestre"
              name="semestre"
              class="form-control"
              placeholder=""
              required
            >
          </div>

          <div class="d-flex justify-content-end gap-2">

            <button
              class="btn btn-outline-secondary"
              onclick="limpiar(event)"
            >
              <i class="fa fa-refresh me-1"></i>
              Limpiar
          </button>

            <button
              type="submit"
              class="btn btn-success"
              id="btnGuardar"
              onclick="agregar(event)"
            >
              <i class="fa fa-save me-1"></i>
              Guardar
            </button>

          </div>

        </form>

      </div>

    </div>

  </div>


  <!-- ========================= -->
  <!-- LISTADO -->
  <!-- ========================= -->
  <div class="col-lg-8 col-md-7 mb-4">

    <div class="card">

      <div class="card-header">
        <h6 class="mb-0">
          <i class="fa fa-list me-2"></i>
          Lista de Carreras
        </h6>
      </div>


      <div class="card-body">

        <!-- HEADER ACTIONS -->
        <div class="d-flex justify-content-between align-items-center mb-3">

          <div class="text-muted">
            <i class="fa fa-graduation-cap me-1"></i>
            Distritos registrados
          </div>
        </div>


        <!-- TABLE -->
        <div class="table-responsive">

          <table class="table table-striped table-hover" id="carrers">

            <thead>
              <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Creditos</th>
                <th>Semestre</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>


            <tbody>

              <% if (carrers && carrers.length > 0) { %>

                <% for (const carrer of carrers) { %>

                  <tr>

                    <td>
                      <%= carrer.id %>
                    </td>

                    <td>
                      <%= carrer.name %>
                    </td>

                    <td>
                      <%= carrer.creditos %>
                    </td>

                    <td>
                      <%= carrer.semestres %>
                    </td>

                    <td class="text-end">

                      <button
                        class="btn btn-sm btn-outline-secondary me-1"
                        onclick="editar(<%= carrer.id %>, event)"
                      >
                        <i class="fa fa-edit" ></i>
                        Editar
                    </button>

                      <button
                        class="btn btn-sm btn-outline-danger"
                        onclick="eliminar(<%= carrer.id %>, event)"
                      >
                        <i class="fa fa-trash"></i>
                        Eliminar
                    </button>

                    </td>

                  </tr>

                <% } %>

              <% } else { %>

                <tr>
                  <td colspan="3" class="text-center text-muted py-4">
                    No se encontraron carreras.
                  </td>
                </tr>

              <% } %>

            </tbody>

          </table>

        </div>

      </div>

    </div>

  </div>

</div>

</div> </main>

<script>
    let carrerRows = document.getElementById("carrers").children[1].children.length;

    function limpiar(event){
      event.preventDefault();
      document.getElementById("carrerId").value="";
      document.getElementById("name").value="";
      document.getElementById("creditos").value="";
      document.getElementById("semestre").value="";
      document.getElementById("cardTitle").innerHTML = "Nueva Carrera";
    }

    function agregar(event){
        event.preventDefault();

        let name = document.getElementById("name").value;
        let creditos = document.getElementById("creditos").value;
        let semestre = document.getElementById("semestre").value;
        let carrersTable = document.getElementById("carrers");
        let carrerId = document.getElementById("carrerId").value;

        if(carrerId==""){
          // MODO AGREGAR: se crea una fila nueva
          let tr = document.createElement("TR");
          let td1 = document.createElement("TD");
          let td2 = document.createElement("TD");
          let td4 = document.createElement("TD");
          let td5 = document.createElement("TD");
          let td3 = document.createElement("TD");
          td3.className = "text-end";

          carrerRows = carrerRows + 1;
          td1.innerHTML = carrerRows;
          td2.innerHTML = name;
          td4.innerHTML = creditos;
          td5.innerHTML = semestre;

          // FIX: antes td3 quedaba vacío, por eso las filas nuevas
          // no tenían botones de Editar/Eliminar. Ahora sí se los damos,
          // usando el mismo id que le acabamos de poner a td1.
          td3.innerHTML = `
            <button class="btn btn-sm btn-outline-secondary me-1" onclick="editar(${carrerRows}, event)">
              <i class="fa fa-edit"></i> Editar
            </button>
            <button class="btn btn-sm btn-outline-danger" onclick="eliminar(${carrerRows}, event)">
              <i class="fa fa-trash"></i> Eliminar
            </button>
          `;

          tr.appendChild(td1);
          tr.appendChild(td2);
          tr.appendChild(td4);
          tr.appendChild(td5);
          tr.appendChild(td3);

          carrersTable.children[1].appendChild(tr);

          limpiar(event);
        }else{
          // MODO EDITAR: se busca la fila con ese id y se actualiza
          let tbody = carrersTable.children[1];

          for (let tr of tbody.children) {
            if(tr.children[0].innerHTML.trim() == carrerId){
              tr.children[1].innerHTML = name;
              tr.children[2].innerHTML = creditos;
              tr.children[3].innerHTML = semestre;
            }
          }
          limpiar(event);
        }
    }

    function eliminar(id, event){
        let tr = event.currentTarget.parentElement.parentElement;
        tr.remove();
    }

    function editar(id, event){
        let tr = event.currentTarget.parentElement.parentElement;
        let name = tr.children[1].innerHTML;
        let creditos = tr.children[2].innerHTML;
        let semestre = tr.children[3].innerHTML;

        document.getElementById("cardTitle").innerHTML = "Editar Carrera";

        document.getElementById("name").value = name.trim();
        document.getElementById("creditos").value = creditos.trim();
        document.getElementById("semestre").value = semestre.trim();
        document.getElementById("carrerId").value = id;
    }
</script>
