<!-- views/partials/_footer.ejs -->

<footer class="bg-dark text-light mt-5">

  <div class="container py-5">

    <div class="row g-4">

      <!-- Brand -->
      <div class="col-lg-4 col-md-6">

        <a
          href="/"
          class="text-decoration-none d-inline-flex align-items-center mb-3">

          <span
            class="bg-success rounded-3 d-flex align-items-center justify-content-center me-2"
            style="width: 40px; height: 40px;">

            <i class="fa-solid fa-graduation-cap text-white"></i>

          </span>

          <span class="fs-5 fw-bold text-light">
            Práctica <span class="text-success">Lima</span>
          </span>

        </a>

        <p class="text-secondary mb-3">
          Conectamos a estudiantes universitarios con
          oportunidades de prácticas pre-profesionales
          para impulsar su desarrollo profesional.
        </p>

        <div class="small text-secondary">
          <i class="fa-solid fa-circle-check text-success me-1"></i>
          Oportunidades para estudiantes
        </div>

      </div>


      <!-- Plataforma -->
      <div class="col-lg-2 col-md-6">

        <h6 class="fw-bold mb-3">
          Plataforma
        </h6>

        <ul class="list-unstyled mb-0">

          <li class="mb-2">
            <a
              href="/"
              class="text-secondary text-decoration-none">

              Inicio

            </a>
          </li>

          <li class="mb-2">
            <a
              href="/convocatorias"
              class="text-secondary text-decoration-none">

              Ofertas laborales

            </a>
          </li>

          <li class="mb-2">
            <a
              href="/empresas"
              class="text-secondary text-decoration-none">

              Empresas

            </a>
          </li>

          <li>
            <a
              href="/como-funciona"
              class="text-secondary text-decoration-none">

              Cómo funciona

            </a>
          </li>

        </ul>

      </div>


      <!-- Para empresas -->
      <div class="col-lg-2 col-md-6">

        <h6 class="fw-bold mb-3">
          Para empresas
        </h6>

        <ul class="list-unstyled mb-0">

          <li class="mb-2">
            <a
              href="/register"
              class="text-secondary text-decoration-none">

              Crear cuenta

            </a>
          </li>

          <li class="mb-2">
            <a
              href="/login"
              class="text-secondary text-decoration-none">

              Iniciar sesión

            </a>
          </li>

          <li>
            <a
              href="/como-funciona"
              class="text-secondary text-decoration-none">

              Publicar una oferta

            </a>
          </li>

        </ul>

      </div>


      <!-- Ayuda -->
      <div class="col-lg-2 col-md-6">

        <h6 class="fw-bold mb-3">
          Ayuda
        </h6>

        <ul class="list-unstyled mb-0">

          <li class="mb-2">
            <a
              href="/preguntas-frecuentes"
              class="text-secondary text-decoration-none">

              Preguntas frecuentes

            </a>
          </li>

          <li class="mb-2">
            <a
              href="/terminos"
              class="text-secondary text-decoration-none">

              Términos del servicio

            </a>
          </li>

          <li>
            <a
              href="/privacidad"
              class="text-secondary text-decoration-none">

              Privacidad de datos

            </a>
          </li>

        </ul>

      </div>


      <!-- Contacto -->
      <div class="col-lg-2 col-md-6">

        <h6 class="fw-bold mb-3">
          Contacto
        </h6>

        <ul class="list-unstyled text-secondary mb-0">

          <li class="mb-3">

            <i class="fa-solid fa-envelope text-success me-2"></i>

            <a
              href="mailto:practicas@ulima.edu.pe"
              class="text-secondary text-decoration-none">

              practicas@ulima.edu.pe

            </a>

          </li>

          <li>

            <i class="fa-solid fa-location-dot text-success me-2"></i>

            Lima, Perú

          </li>

        </ul>

      </div>

    </div>


    <!-- Divider -->
    <hr class="border-secondary my-4">


    <!-- Bottom -->
    <div
      class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">

      <!-- Copyright -->
      <div class="text-secondary small">

        © <%= new Date().getFullYear() %> Práctica Lima.
        Todos los derechos reservados.

      </div>


      <!-- University -->
      <div>

        <a
          href="https://www.ulima.edu.pe/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-secondary text-decoration-none small">

          <i class="fa-solid fa-graduation-cap text-success me-1"></i>

          Universidad de Lima

          <i
            class="fa-solid fa-arrow-up-right-from-square ms-1 small">
          </i>

        </a>

      </div>

    </div>

  </div>

</footer>
